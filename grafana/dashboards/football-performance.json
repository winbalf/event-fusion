          "rawSql": "SELECT\n  league_name,\n  SUM(matches_count) AS matches,\n  SUM(completed_matches_count) AS completed,\n  SUM(scheduled_matches_count) AS scheduled,\n  SUM(in_progress_matches_count) AS in_progress,\n  ROUND(AVG(avg_goals_per_match), 2) AS avg_goals_per_match\nFROM `event_fusion.fct_daily_weather_sports`\nGROUP BY league_name\nORDER BY matches DESC",
